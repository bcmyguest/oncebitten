{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/oncebitten\" capture --host cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/oncebitten\" capture --host cursor"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/bin/oncebitten\" capture --host cursor"
      }
    ]
  }
}
