#!/bin/sh
# Agent plugin launcher. Runs the release binary that matches this
# plugin's version, installing it into the plugin data dir on first use.
set -u

version=0.5.0
data="${CLAUDE_PLUGIN_DATA:-${PLUGIN_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/oncebitten}}"
dir="$data/bin/$version"
here="$(cd "$(dirname "$0")" && pwd)"
case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*) exe=.exe ;;
    *) exe= ;;
esac

fetch() {
    ONCEBITTEN_VERSION="$version" ONCEBITTEN_INSTALL_DIR="$dir" sh "$here/../scripts/install.sh"
}

if [ ! -f "$dir/oncebitten$exe" ]; then
    case "${1:-}" in
        capture | steer)
            # A hook must not wait on a download: drop this event, fetch in the background.
            cat >/dev/null
            fetch >/dev/null 2>&1 &
            exit 0
            ;;
    esac
    fetch || exit 2
fi
exec "$dir/oncebitten$exe" "$@"
